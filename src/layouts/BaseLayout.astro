---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import GoogleTagManager from '../components/GoogleTagManager.astro';

interface Props {
  title: string;
  description: string;
  currentPath: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  noindex?: boolean;
  /** Article category label, e.g. "Technology" */
  category?: string;
  /** Reading time in minutes */
  readingTime?: number;
  /** Article tags */
  tags?: string[];
  /** Question/answer pairs, also rendered visibly by the caller */
  faq?: { q: string; a: string }[];
}

const {
  title,
  description,
  currentPath,
  image = "/images/default-og.jpg",
  imageAlt,
  type = "website",
  pubDate,
  noindex = false,
  category,
  readingTime,
  tags = [],
  faq = [],
} = Astro.props;

const ogImageAlt = imageAlt || title;

const SITE   = 'https://www.robatdasorvi.com';
const AUTHOR = 'Robat Das Orvi';
const AUTHOR_ID = `${SITE}/#orvi`;

const canonicalURL  = new URL(currentPath, SITE).toString();
const socialImage   = new URL(image, SITE).toString();
const datePublished = pubDate ? new Date(pubDate).toISOString() : undefined;
const dateModified  = new Date().toISOString();

const GTM_ID = import.meta.env.PUBLIC_GTM_ID || '';
const GSC_VERIFICATION = import.meta.env.PUBLIC_GSC_VERIFICATION || '';
const BING_VERIFICATION = import.meta.env.PUBLIC_BING_VERIFICATION || '';
const GA4_ID = import.meta.env.PUBLIC_GA4_ID || 'G-8MDK069LNK';

// ── Person / author entity (used across all pages) ──────────────────────────
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": AUTHOR_ID,
  "name": AUTHOR,
  "alternateName": "Orvi",
  "url": SITE,
  "description": "Writer, systems thinker, and builder of calm products. Co-creator of OneThread and AgencyHandy.",
  "knowsAbout": [
    "Travel", "Technology", "Artificial Intelligence", "Automation",
    "Startups", "Founder Psychology", "Philosophy", "Psychology", "Football"
  ],
  "sameAs": [
    "https://agencyhandy.com",
    "https://www.onethreadapp.com",
    "https://noburn.dev",
    "https://apidiffguard.com",
    "https://twitter.com/orvi_onethread",
    "https://github.com/orvi2014"
  ]
};

// ── Website / blog entity ────────────────────────────────────────────────────
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": `${SITE}/#website`,
  "name": "The Book of Life",
  "url": SITE,
  "description": "A collection of long-form essays on travel, technology, startups, philosophy, psychology, and football.",
  "inLanguage": "en-US",
  "author": { "@id": AUTHOR_ID },
  "publisher": { "@id": AUTHOR_ID },
  "potentialAction": {
    "@type": "SearchAction",
    "target": { "@type": "EntryPoint", "urlTemplate": `${SITE}/search?q={search_term_string}` },
    "query-input": "required name=search_term_string"
  }
};

// ── Article schema (only on article pages) ───────────────────────────────────
const articleSchema = type === 'article' ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": canonicalURL,
  "headline": title,
  "name": title,
  "description": description,
  "url": canonicalURL,
  "image": socialImage,
  "datePublished": datePublished,
  "dateModified": dateModified,
  "inLanguage": "en-US",
  "isAccessibleForFree": true,
  "author": { "@id": AUTHOR_ID },
  "publisher": {
    "@type": "Person",
    "@id": AUTHOR_ID,
    "name": AUTHOR
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalURL },
  ...(category ? { "articleSection": category } : {}),
  ...(readingTime ? { "timeRequired": `PT${readingTime}M` } : {}),
  ...(tags.length ? { "keywords": tags.join(', ') } : {}),
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": [".art-kicker", ".art-title", ".art-pull", ".art-body p:first-of-type"]
  }
} : null;

// ── FAQPage (only when the caller also renders the Q&A visibly) ──────────────
const faqSchema = faq.length ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${canonicalURL}#faq`,
  "mainEntity": faq.map(({ q, a }: { q: string; a: string }) => ({
    "@type": "Question",
    "name": q,
    "acceptedAnswer": { "@type": "Answer", "text": a }
  }))
} : null;

// ── BreadcrumbList (article pages only) ──────────────────────────────────────
const pathParts = currentPath.replace(/^\/|\/$/g, '').split('/');
const breadcrumbs = type === 'article' && pathParts.length > 1 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": SITE },
    { "@type": "ListItem", "position": 2, "name": "Chapters", "item": `${SITE}/chapters` },
    { "@type": "ListItem", "position": 3, "name": title, "item": canonicalURL }
  ]
} : null;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    {GTM_ID && <GoogleTagManager id={GTM_ID} />}

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Search Console verification (set PUBLIC_GSC_VERIFICATION in .env) -->
    {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}

    <!-- Bing Webmaster Tools verification (set PUBLIC_BING_VERIFICATION in .env).
         Only needed if you verify by meta tag; importing from GSC needs no tag. -->
    {BING_VERIFICATION && <meta name="msvalidate.01" content={BING_VERIFICATION} />}

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <!-- Feed autodiscovery. Aggregators (daily.dev, Feedly, Substack/Medium
         importers) look for this tag to find the feed from any page — without
         it the feed only works if someone already knows the exact URL. -->
    <link rel="alternate" type="application/rss+xml" title="Robat Das Orvi" href={new URL('/rss.xml', SITE).toString()} />
    <meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"} />
    <meta name="author" content={AUTHOR} />
    <meta name="language" content="en" />
    <meta name="theme-color" content="#f5f1eb" />

    <!-- Open Graph (Facebook, WhatsApp, LinkedIn, Telegram) -->
    <meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="The Book of Life" />
    <meta property="og:locale" content="en_US" />
    {type === 'article' && datePublished && <meta property="article:published_time" content={datePublished} />}
    {type === 'article' && <meta property="article:modified_time" content={dateModified} />}
    {type === 'article' && <meta property="article:author" content={`${SITE}/#orvi`} />}
    {type === 'article' && category && <meta property="article:section" content={category} />}
    {tags.map(tag => <meta property="article:tag" content={tag} />)}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@orvi_onethread" />
    <meta name="twitter:creator" content="@orvi_onethread" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- LinkedIn -->
    <meta property="og:author" content={AUTHOR} />

    <!-- Pinterest -->
    <meta name="pinterest-rich-pin" content="true" />

    <!-- Fediverse / Mastodon author verification -->
    <meta name="fediverse:creator" content="@orvi_onethread" />

    <!-- Social profile links (machine-readable, used by Google + Mastodon) -->
    <link rel="me" href="https://twitter.com/orvi_onethread" />
    <link rel="me" href="https://github.com/orvi2014" />

    <!-- Web App Manifest -->
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <!-- Fonts come from Google Fonts below, not from /public/fonts. Preload tags
         for local woff2 files used to sit here and 404ed on every page. -->

    <!-- Google Fonts.
         Loaded render-blocking on purpose. The previous media="print"
         onload="this.media='all'" trick made this non-blocking, which meant
         the page always painted in fallback serif first and then visibly
         re-rendered in EB Garamond once the stylesheet arrived. On a
         typography-led layout that swap is the flicker readers notice. The
         preconnects above keep the blocking cost small. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Google Analytics 4 -->
    {GA4_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
        <script define:vars={{ GA4_ID }} is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', GA4_ID);
        </script>
      </>
    )}

    <!-- ── Structured Data ────────────────────────────────────────────── -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
    {breadcrumbs && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />}
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

    <!-- The search modal is inert until its own script opens it, so keep it
         out of the first paint. Everything else renders immediately: gating
         the page on JavaScript is what caused the flicker this replaced. -->
    <style is:inline>
      .search-modal, .search-results { display: none; }
    </style>
  </head>
  <body>
    <div class="page-content">
      <Header currentPath={currentPath} />
      <main>
        <slot />
      </main>
      <Footer />
    </div>

    <SearchModal />
    <div id="modal-root"></div>
  </body>
</html>

<style>
  .skeleton-content {
    max-width: 860px;
    margin: 0 auto;
    padding: 2rem;
  }
</style>
