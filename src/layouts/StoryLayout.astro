---
import BaseLayout from './BaseLayout.astro';
import RelatedStories from '../components/RelatedStories.astro';
import Newsletter from '../components/Newsletter.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  story: CollectionEntry<'stories'>;
}

const { story } = Astro.props;
const { Content } = await story.render();
const { title, description, pubDate, updatedDate, author, readingTime, tags, category, image, faq } = story.data;

const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric', month: 'short', day: 'numeric'
});

const categories = await getCollection('categories');
const categoryInfo = categories.find((c: CollectionEntry<'categories'>) => c.slug === category);
const kicker = categoryInfo ? categoryInfo.data.title : category;
// The running head names the chapter by its number, so it no longer repeats
// the category label printed right above the title.
const ROMANS = ['I','II','III','IV','V','VI','VII','VIII','IX','X','XI','XII','XIII','XIV','XV','XVI','XVII','XVIII','XIX','XX'];
// Same numbering as the contents page: chapters with no essays are skipped.
const allStories = await getCollection('stories');
const chapterIndex = categories
  .filter((c: CollectionEntry<'categories'>) => allStories.some((st: CollectionEntry<'stories'>) => st.data.category === c.slug))
  .sort((a: CollectionEntry<'categories'>, b: CollectionEntry<'categories'>) => a.data.order - b.data.order)
  .findIndex((c: CollectionEntry<'categories'>) => c.slug === category);
const chapterLabel = chapterIndex >= 0 ? `Chapter ${ROMANS[chapterIndex] ?? chapterIndex + 1}` : 'The Book of Life';
const meta = [
  readingTime ? `${readingTime} min read` : null,
  formattedDate,
].filter(Boolean) as string[];
---

<BaseLayout
  {/* No brand suffix. Google truncates title links near 60 characters, and
      " – The Book of Life" costs 19 of them on every page — enough to push 76
      of 81 stories past the cut, including titles that would otherwise fit.
      The brand is already carried by og:site_name and by the site name Google
      renders above the title link, so the suffix only duplicated a signal at
      the cost of the payoff clause readers actually decide on. */}
  title={title}
  description={description}
  currentPath={`/chapters/${story.data.category}/${story.slug}`}
  image={image || `/og/${story.data.category}/${story.slug}.png`}
  imageType={image ? undefined : 'image/png'}
  imageAlt={`${title}, from The Book of Life by Orvi`}
  type="article"
  pubDate={pubDate}
  updatedDate={updatedDate}
  category={kicker}
  readingTime={readingTime}
  tags={tags || []}
  faq={faq || []}
>
  <div class="art-scene">
    <div class="art-nav">
      <a href="/chapters" class="art-back">← Back to Chapters</a>
    </div>

    <div class="art-page">
      <div class="art-page-head">
        <span>{chapterLabel}</span>
        <span>The Book of Life</span>
      </div>

      <a class="art-kicker" href={`/chapters/${category}`}>{kicker}</a>
      <h1 class="art-title">{title}</h1>
      <div class="art-rule"></div>
      <div class="art-meta">{meta.map((m) => <span>{m}</span>)}<span>By <a href="/profile" rel="author">{author === 'Orvi' ? 'Robat Das Orvi' : author}</a></span>{updatedDate && <span>Updated <time datetime={updatedDate.toISOString()}>{updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time></span>}</div>

      {description && (
        <blockquote class="art-pull">{description}</blockquote>
      )}

      <div class="art-body">
        <Content />

        {faq && faq.length > 0 && (
          <section class="art-faq">
            <h2>Quick answers</h2>
            <dl>
              {faq.map(({ q, a }: { q: string; a: string }) => (
                <>
                  <dt>{q}</dt>
                  <dd>{a}</dd>
                </>
              ))}
            </dl>
          </section>
        )}
      </div>

      <div class="art-page-foot">
        <span>The Book of Life</span>
        <span>Orvi, {new Date(pubDate).getFullYear()}</span>
      </div>
    </div>

    {tags && tags.length > 0 && (
      <div class="art-tags">
        {tags.map((tag: string) => (
          <span class="art-tag">{tag}</span>
        ))}
      </div>
    )}

    <Newsletter />

    <RelatedStories story={story} />
  </div>
</BaseLayout>

<style>
  .art-scene {
    background: var(--scene);
    min-height: calc(100vh - 54px);
    padding: 32px 20px 64px;
  }

  .art-faq {
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule-strong);
  }

  .art-faq h2 {
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-2);
    margin: 0 0 1.1rem;
  }

  .art-faq dl {
    margin: 0;
  }

  .art-faq dt {
    font-weight: 600;
    margin-top: 1.25rem;
  }

  .art-faq dt:first-of-type {
    margin-top: 0;
  }

  .art-faq dd {
    margin: 0.35rem 0 0;
  }

  .art-nav {
    max-width: 680px;
    margin: 0 auto 18px;
  }

  .art-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: var(--text-2);
    font-family: var(--font-sans);
    text-decoration: none;
    transition: color 0.14s;
  }

  .art-back:hover { color: var(--ink); }

  .art-page {
    max-width: 680px;
    margin: 0 auto;
    background: var(--paper);
    border: 0.5px solid var(--rule);
    padding: 38px 56px 80px;
    position: relative;
    box-shadow:
      0 4px 28px var(--shadow),
      0 1px 5px var(--shadow);
    min-height: 640px;
  }

  .art-page-head {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 38px;
    padding-bottom: 7px;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-sans);
  }

  .art-kicker {
    display: inline-block;
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sienna);
    margin-bottom: 12px;
    font-family: var(--font-sans);
  }

  .art-title {
    font-family: var(--font-serif);
    font-size: 40px;
    line-height: 1.06;
    letter-spacing: -0.018em;
    font-weight: 400;
    color: var(--ink);
    margin-bottom: 14px;
  }

  .art-rule {
    width: 32px;
    height: 1.5px;
    background: var(--sienna);
    margin-bottom: 12px;
  }

  .art-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    font-size: 13px;
    color: var(--text-2);
    margin-bottom: 30px;
    font-family: var(--font-sans);
  }

  .art-pull {
    border-inline-start: 2px solid var(--sienna);
    padding: 4px 0 4px 18px;
    margin: 0 0 28px;
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.52;
    font-style: italic;
    color: var(--ink);
  }

  .art-body {
    font-family: var(--font-serif);
    font-size: 17px;
    line-height: 1.88;
    color: var(--ink);
  }

  .art-page-foot {
    position: absolute;
    bottom: 22px;
    left: 56px;
    right: 56px;
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--muted);
    font-family: var(--font-serif);
    border-top: 1px solid var(--rule);
    padding-top: 7px;
  }

  .art-tags {
    max-width: 680px;
    margin: 18px auto 0;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .art-tag {
    font-size: 12px;
    color: var(--text-2);
    font-family: var(--font-sans);
    letter-spacing: 0.04em;
    padding: 3px 10px;
    border: 1px solid var(--rule-strong);
    border-radius: 2px;
  }

  @media (max-width: 680px) {
    .art-page {
      padding: 28px 24px 72px;
    }
    .art-page-head { display: none; }
    .art-title { font-size: 30px; }
    .art-body { font-size: 16px; }
    .art-page-foot { left: 24px; right: 24px; }
    .art-pull { font-size: 16px; }
  }
</style>

<style is:global>
  .art-body p {
    margin-bottom: 1.45em;
  }

  .art-body p:first-of-type::first-letter {
    float: left;
    font-size: 64px;
    line-height: 0.80;
    padding: 5px 10px 0 0;
    color: var(--sienna);
    font-weight: 400;
    font-family: var(--font-serif);
  }

  .art-body h2 {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 400;
    color: var(--ink);
    margin: 2em 0 0.6em;
  }

  .art-body h3 {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 400;
    color: var(--ink);
    margin: 1.5em 0 0.5em;
  }

  .art-body blockquote {
    border-inline-start: 2px solid var(--sienna);
    padding: 4px 0 4px 18px;
    margin: 1.5em 0;
    font-style: italic;
    color: var(--text-2);
  }

  .art-body a {
    color: var(--sienna);
    text-decoration: underline;
    text-decoration-color: var(--link-line);
    text-underline-offset: 2px;
  }

  .art-body ul, .art-body ol {
    padding-left: 1.5em;
    margin-bottom: 1.45em;
  }

  .art-body li { margin-bottom: 0.4em; }

  .art-body code {
    font-size: 0.88em;
    background: var(--code-bg);
    padding: 0.1em 0.35em;
    border-radius: 2px;
  }

  .art-body pre {
    background: var(--code-bg);
    padding: 1em 1.25em;
    border-radius: 3px;
    overflow-x: auto;
    margin-bottom: 1.45em;
    font-size: 0.88em;
  }

  .art-body pre code {
    background: none;
    padding: 0;
  }

  .art-body img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 1.5em 0;
  }

  .art-body hr {
    border: none;
    border-top: 1px solid var(--rule-strong);
    margin: 2em 0;
  }

  .art-body table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92em;
    margin: 1.4em 0 1.6em;
  }

  .art-body th,
  .art-body td {
    text-align: left;
    padding: 0.45em 0.6em 0.45em 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }

  .art-body th {
    font-size: 0.78em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--text-2);
  }
</style>
