---
const year = new Date().getFullYear();
// Convert to Roman numerals for the book aesthetic
const toRoman = (n: number) => {
  const vals = [1000,900,500,400,100,90,50,40,10,9,5,4,1];
  const syms = ['M','CM','D','CD','C','XC','L','XL','X','IX','V','IV','I'];
  let result = '';
  for (let i = 0; i < vals.length; i++) {
    while (n >= vals[i]) { result += syms[i]; n -= vals[i]; }
  }
  return result;
};
const romanYear = toRoman(year);
---
<footer class="site-footer">
  <span>The Book of Life &nbsp;·&nbsp; Orvi &nbsp;·&nbsp; {romanYear}</span>
</footer>

<style>
  .site-footer {
    text-align: center;
    padding: 28px 24px;
    font-family: var(--font-serif);
    /* Was rgba(122,110,101,0.5), which composites to #b7afa8 on --bg and
       measures 1.91:1, far below the 4.5:1 needed for readable text. The
       half-opacity was doing the work of a lighter colour; using the token
       at full strength gives 4.86:1 and looks near-identical. */
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--muted);
    border-top: 1px solid var(--border);
    background: var(--bg);
  }
</style> 