---
/**
 * Buttondown signup.
 *
 * Posts straight to Buttondown, so this works on a fully static build with no
 * API route, no serverless function and no database. That is deliberate: the
 * previous Supabase-backed form needed all three and silently captured nothing.
 *
 * Set PUBLIC_BUTTONDOWN_USERNAME in .env. Without it the component renders
 * nothing rather than shipping a form that posts into the void.
 */
interface Props {
  /** Override the default heading */
  heading?: string;
  /** Override the default supporting line */
  blurb?: string;
}

const {
  heading = 'Get new chapters by email',
  blurb = 'Long-form essays on football tactics, AI, and the psychology of building things. No schedule, no filler, unsubscribe whenever.',
} = Astro.props;

const username = import.meta.env.PUBLIC_BUTTONDOWN_USERNAME;
const action = `https://buttondown.com/api/emails/embed-subscribe/${username}`;
---

{username && (
  <aside class="nl">
    <h2 class="nl-title">{heading}</h2>
    <p class="nl-blurb">{blurb}</p>

    <form class="nl-form" action={action} method="post" data-newsletter>
      <label class="nl-label" for="bd-email">Email address</label>
      <div class="nl-row">
        <input
          class="nl-input"
          type="email"
          name="email"
          id="bd-email"
          placeholder="you@example.com"
          autocomplete="email"
          required
        />
        <button class="nl-btn" type="submit">Subscribe</button>
      </div>
      <p class="nl-msg" data-newsletter-msg role="status" aria-live="polite"></p>
    </form>
  </aside>
)}

<script>
  // Buttondown's stock embed opens buttondown.com/<username> in a popup after
  // submitting. That page 404s unless the public archive is enabled, so every
  // subscriber would see a 404 and assume the signup failed. The endpoint
  // sends access-control-allow-origin:*, so submit with fetch and confirm
  // in place instead. The plain form POST stays as the no-JS fallback.
  function initNewsletter() {
    document.querySelectorAll('form[data-newsletter]').forEach((form) => {
      if (form.dataset.bound) return;
      form.dataset.bound = 'true';

      const msg = form.querySelector('[data-newsletter-msg]');
      const button = form.querySelector('button[type="submit"]');

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const original = button.textContent;
        button.disabled = true;
        button.textContent = 'Subscribing…';
        msg.textContent = '';
        msg.classList.remove('is-error', 'is-ok');

        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            // A successful subscribe answers 302. Do not follow it, or we land
            // on the archive page and cannot tell success from failure.
            redirect: 'manual',
          });

          if (res.type === 'opaqueredirect' || res.ok) {
            msg.textContent = 'Almost there. Check your inbox to confirm.';
            msg.classList.add('is-ok');
            form.reset();
          } else {
            msg.textContent = 'That did not go through. Try again in a moment.';
            msg.classList.add('is-error');
          }
        } catch {
          msg.textContent = 'Network error. Try again in a moment.';
          msg.classList.add('is-error');
        } finally {
          button.disabled = false;
          button.textContent = original;
        }
      });
    });
  }

  initNewsletter();
  // View transitions swap the DOM without a full reload.
  document.addEventListener('astro:page-load', initNewsletter);
</script>

<style>
  .nl {
    max-width: 42rem;
    margin: 3rem auto 0;
    padding: 1.9rem 1.7rem;
    border: 1px solid rgba(90, 70, 50, 0.22);
    background: rgba(255, 253, 248, 0.55);
  }

  .nl-title {
    font-family: var(--font-serif);
    font-size: 1.28rem;
    line-height: 1.3;
    margin: 0 0 0.5rem;
    color: rgba(50, 38, 28, 0.95);
  }

  .nl-blurb {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0 0 1.15rem;
    color: rgba(90, 70, 50, 0.72);
  }

  /* Visible to screen readers only; the placeholder carries the visual cue. */
  .nl-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .nl-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .nl-input {
    flex: 1 1 15rem;
    min-width: 0;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    padding: 0.62rem 0.75rem;
    border: 1px solid rgba(90, 70, 50, 0.3);
    background: #fffdf8;
    color: rgba(50, 38, 28, 0.95);
    border-radius: 2px;
  }

  .nl-input:focus-visible {
    outline: 2px solid var(--sienna, #8a4b2a);
    outline-offset: 1px;
  }

  .nl-btn {
    font-family: var(--font-sans);
    font-size: 0.86rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.62rem 1.2rem;
    border: 1px solid var(--sienna, #8a4b2a);
    background: var(--sienna, #8a4b2a);
    color: #fffdf8;
    cursor: pointer;
    border-radius: 2px;
    transition: opacity 0.15s;
  }

  .nl-btn:hover { opacity: 0.86; }

  .nl-btn:focus-visible {
    outline: 2px solid rgba(50, 38, 28, 0.9);
    outline-offset: 2px;
  }

  .nl-btn:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .nl-msg {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    line-height: 1.5;
    margin: 0.7rem 0 0;
    min-height: 1.2em;
  }

  .nl-msg.is-ok { color: rgba(60, 100, 60, 0.95); }
  .nl-msg.is-error { color: rgba(150, 55, 40, 0.95); }
</style>
