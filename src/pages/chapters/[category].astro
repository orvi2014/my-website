---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const categories = await getCollection('categories');
  return Promise.all(
    categories.map(async (category) => {
      const { Content } = await category.render();
      return {
        params: { category: category.slug },
        props: { category, Content },
      };
    })
  );
}

const { category, Content } = Astro.props;
const stories = await getCollection('stories', (story) => 
  story.data.category === category.slug
);

const sortedStories = stories.sort((a, b) => 
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

// Get featured article (if exists)
const featuredStory = sortedStories.find((story: CollectionEntry<'stories'>) => 
  story.data.featured === true
) || sortedStories[0];

// Get non-featured stories
const otherStories = sortedStories.filter((story: CollectionEntry<'stories'>) => 
  story.slug !== featuredStory?.slug
);

// Other chapters, in book order, numbered the same way as the contents page
// (chapters with no essays are skipped there too).
const allCategories = await getCollection('categories');
const allStories = await getCollection('stories');
const ROMANS = ['I','II','III','IV','V','VI','VII','VIII','IX','X','XI','XII','XIII','XIV','XV','XVI','XVII','XVIII','XIX','XX'];
const book = allCategories
  .slice()
  .sort((a: CollectionEntry<'categories'>, b: CollectionEntry<'categories'>) => a.data.order - b.data.order)
  .map((cat: CollectionEntry<'categories'>) => ({
    cat,
    count: allStories.filter((st: CollectionEntry<'stories'>) => st.data.category === cat.slug).length,
  }))
  .filter((c) => c.count > 0)
  .map((c, i) => ({ ...c, roman: ROMANS[i] ?? String(i + 1) }));
const here = book.find((c) => c.cat.slug === category.slug);
const otherChapters = book.filter((c) => c.cat.slug !== category.slug);
const fmt = (d: Date) => new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const ordered = featuredStory ? [featuredStory, ...otherStories] : otherStories;

const title = `${category.data.title}: The Book of Life`;
const description = category.data.description;
const currentPath = `/chapters/${category.slug}`;
---

<BaseLayout
  title={title}
  description={description}
  currentPath={currentPath}
>
  <div class="cp-scene">
    <div class="cp-nav">
      <a href="/chapters" class="cp-back">← All chapters</a>
    </div>

    <article class="cp-page">
      <div class="cp-head">
        <span>{here ? `Chapter ${here.roman}` : 'The Book of Life'}</span>
        <span>The Book of Life</span>
      </div>

      <header class="cp-header">
        {here && <div class="cp-roman" aria-hidden="true">{here.roman}</div>}
        <h1 class="cp-title">{category.data.title}</h1>
        <div class="cp-rule"></div>
        <p class="cp-desc">{category.data.description}</p>
      </header>

      <div class="cp-intro">
        <Content />
      </div>

      {ordered.length > 0 && (
        <section class="cp-essays" aria-labelledby="essays-title">
          <h2 id="essays-title" class="cp-h2">{ordered.length} {ordered.length === 1 ? 'essay' : 'essays'} in this chapter</h2>
          <ol class="cp-list">
            {ordered.map((story: CollectionEntry<'stories'>) => (
              <li>
                <a href={`/chapters/${story.data.category}/${story.slug}`}>
                  <span class="cp-e-title">{story.data.title}</span>
                  {story.data.description && <span class="cp-e-desc">{story.data.description}</span>}
                  <span class="cp-e-meta">
                    <time datetime={story.data.pubDate.toISOString()}>{fmt(story.data.pubDate)}</time>
                    {story.data.readingTime && <span>{story.data.readingTime} min read</span>}
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )}
    </article>

    {otherChapters.length > 0 && (
      <nav class="cp-others" aria-labelledby="others-title">
        <h2 id="others-title" class="cp-h2">Other chapters</h2>
        <ul>
          {otherChapters.map(({ cat, count, roman }) => (
            <li>
              <a href={`/chapters/${cat.slug}`}>
                <span class="cp-o-roman">{roman}</span>
                <span class="cp-o-name">{cat.data.title}</span>
                <span class="cp-o-count">{count}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": category.data.title,
  "description": category.data.description,
  "url": `https://www.robatdasorvi.com/chapters/${category.slug}`,
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://www.robatdasorvi.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Chapters",
        "item": "https://www.robatdasorvi.com/chapters"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": category.data.title,
        "item": `https://www.robatdasorvi.com/chapters/${category.slug}`
      }
    ]
  }
})} />

<style>
  .cp-scene { background: var(--scene); min-height: calc(100vh - 54px); padding: 32px 20px 72px; }
  .cp-nav, .cp-others { max-width: 760px; margin: 0 auto; }
  .cp-nav { margin-bottom: 18px; }
  .cp-back { font-family: var(--font-sans); font-size: 13px; color: var(--text-2); text-decoration: none; }
  .cp-back:hover { color: var(--ink); }

  .cp-page {
    max-width: 760px; margin: 0 auto; background: var(--paper);
    border: 1px solid var(--rule); padding: 38px 64px 56px;
    box-shadow: 0 4px 28px var(--shadow), 0 1px 5px var(--shadow);
  }
  .cp-head {
    display: flex; justify-content: space-between; gap: 16px;
    font-family: var(--font-sans); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--muted); padding-bottom: 7px; border-bottom: 1px solid var(--rule); margin-bottom: 44px;
  }
  .cp-header { margin-bottom: 32px; }
  .cp-roman { font-family: var(--font-serif); font-style: italic; font-size: 64px; line-height: 1; color: var(--sienna); margin-bottom: 8px; }
  .cp-title { font-family: var(--font-serif); font-weight: 400; font-size: 46px; line-height: 1.05; letter-spacing: -0.018em; color: var(--ink); margin-bottom: 16px; }
  .cp-rule { width: 32px; height: 1.5px; background: var(--sienna); margin-bottom: 16px; }
  .cp-desc { font-family: var(--font-serif); font-style: italic; font-size: 20px; line-height: 1.5; color: var(--text-2); max-width: 36em; }

  .cp-intro { font-family: var(--font-serif); font-size: 17px; line-height: 1.85; color: var(--ink); max-width: 38em; }
  .cp-intro :global(p) { margin-bottom: 1.2em; }
  .cp-intro :global(h2) { font-family: var(--font-serif); font-weight: 400; font-size: 22px; margin: 1.8em 0 0.5em; color: var(--ink); }

  .cp-essays { margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--rule-strong); }
  .cp-h2 { font-family: var(--font-serif); font-weight: 400; font-size: 22px; color: var(--ink); margin-bottom: 8px; }
  .cp-list { list-style: none; }
  .cp-list a { display: grid; gap: 5px; padding: 18px 0; border-bottom: 1px solid var(--rule); text-decoration: none; }
  .cp-e-title { font-family: var(--font-serif); font-size: 21px; line-height: 1.3; color: var(--ink); transition: color 0.14s; }
  .cp-list a:hover .cp-e-title { color: var(--sienna); }
  .cp-e-desc { font-family: var(--font-serif); font-size: 16px; line-height: 1.55; color: var(--text-2); }
  .cp-e-meta { display: flex; flex-wrap: wrap; gap: 4px 16px; font-family: var(--font-sans); font-size: 13px; color: var(--muted); }

  .cp-others { margin-top: 40px; }
  .cp-others ul { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 32px; }
  .cp-others a { display: flex; align-items: baseline; gap: 12px; padding: 11px 0; border-bottom: 1px solid var(--rule); text-decoration: none; }
  .cp-o-roman { width: 34px; flex: none; font-family: var(--font-serif); font-style: italic; font-size: 14px; color: var(--muted); }
  .cp-o-name { flex: 1; min-width: 0; font-family: var(--font-serif); font-size: 17px; color: var(--ink); }
  .cp-others a:hover .cp-o-name { color: var(--sienna); }
  .cp-o-count { font-family: var(--font-sans); font-size: 13px; color: var(--muted); }

  @media (max-width: 680px) {
    .cp-page { padding: 28px 24px 40px; }
    .cp-head { display: none; }
    .cp-title { font-size: 34px; }
    .cp-roman { font-size: 48px; }
    .cp-desc { font-size: 18px; }
    .cp-intro { font-size: 16px; }
    .cp-others ul { grid-template-columns: minmax(0, 1fr); }
  }
</style>
