---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const title = "The Book of Life by Orvi";
const description = "The Book of Life: personal essays on AI, building software, philosophy, psychology, football and travel. By Robat Das Orvi, a builder and writer from Bangladesh.";
const currentPath = "/";

const stories = await getCollection('stories');
const categories = await getCollection('categories');
const chapterTitle = (slug: string) =>
  categories.find((c: CollectionEntry<'categories'>) => c.slug === slug)?.data.title ?? slug;
const byDate = stories
  .slice()
  .sort((a: CollectionEntry<'stories'>, b: CollectionEntry<'stories'>) => +new Date(b.data.pubDate) - +new Date(a.data.pubDate));
const latest = byDate.slice(0, 5).map((s: CollectionEntry<'stories'>) => ({
  href: `/chapters/${s.data.category}/${s.slug}`,
  title: s.data.title,
  chapter: chapterTitle(s.data.category),
  date: new Date(s.data.pubDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }),
}));
const firstYear = new Date(byDate[byDate.length - 1]?.data.pubDate ?? Date.now()).getFullYear();
const year = new Date().getFullYear();
---

<BaseLayout title={title} description={description} currentPath={currentPath}>
  <div class="cover-wrap">

    <div class="book-card">
      <div class="bc-bookmark"></div>
      <div class="bc-frame"></div>
      <div class="bc-corner tl"></div>
      <div class="bc-corner tr"></div>
      <div class="bc-corner bl"></div>
      <div class="bc-corner br"></div>

      <div class="bc-body">
        <div class="bc-eyebrow">Collected essays</div>
        <div class="bc-hr">
          <span class="bc-hr-line"></span>
          <span class="bc-hr-diamond">◆</span>
          <span class="bc-hr-line"></span>
        </div>
        <div class="bc-title">The Book<br>of Life</div>
        <div class="bc-ornament">
          <span class="bc-orn-line"></span>
          <span class="bc-orn-glyph">❧</span>
          <span class="bc-orn-line"></span>
        </div>
        <div class="bc-subtitle">
          A collection of thoughts, experiences,<br>and discoveries
        </div>
        <div class="bc-topics">
          On AI, building, philosophy, psychology,<br>football, chess and travel
        </div>
      </div>

      <div class="bc-footer">
        <div class="bc-author">By Orvi</div>
        <div class="bc-edition">{firstYear} to {year}</div>
      </div>
    </div>

    <div class="cover-actions">
      <a href="/chapters" class="bc-open">Open the book</a>
    </div>

  </div>

  <section class="home-latest" aria-labelledby="latest-title">
    <div class="hl-intro">
      <h1 class="hl-name">Robat Das Orvi</h1>
      <p class="hl-line">I co-created OneThread and AgencyHandy, now build guardrails for AI systems, and write about what building, thinking and football have taught me. {stories.length} essays so far.</p>
      <a class="hl-more" href="/about">About me</a>
    </div>
    <div class="hl-list">
      <h2 class="hl-title" id="latest-title">Latest essays</h2>
      <ol>
        {latest.map((e) => (
          <li>
            <a href={e.href}>
              <span class="hl-essay">{e.title}</span>
              <span class="hl-meta"><span>{e.chapter}</span><span>{e.date}</span></span>
            </a>
          </li>
        ))}
      </ol>
      <a class="hl-more" href="/chapters">All chapters</a>
    </div>
  </section>
</BaseLayout>

<style>
  .cover-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 56px 24px 64px;
    background: var(--bg);
  }

  /* ── Book card ── */
  .book-card {
    width: 420px;
    position: relative;
    background: linear-gradient(148deg, #2e1a08 0%, #1e1008 35%, #140c06 65%, #0c0804 100%);
    transform: perspective(1100px) rotateY(-3deg) rotateX(1.5deg);
    box-shadow:
      6px 18px 56px rgba(0,0,0,0.50),
      18px 36px 84px rgba(0,0,0,0.26),
      2px 4px 10px rgba(0,0,0,0.32);
    transition: transform 0.5s ease, box-shadow 0.5s ease;
  }

  .book-card:hover {
    transform: perspective(1100px) rotateY(-1deg) rotateX(0.5deg) translateY(-5px);
    box-shadow:
      10px 28px 76px rgba(0,0,0,0.50),
      26px 52px 100px rgba(0,0,0,0.22),
      2px 4px 10px rgba(0,0,0,0.28);
  }

  /* Page edges (right side) */
  .book-card::after {
    content: '';
    position: absolute;
    top: 5px; right: -13px; bottom: 5px;
    width: 15px;
    background: repeating-linear-gradient(
      to bottom,
      #f0e6d4 0, #f0e6d4 1.2px,
      #dfd2bc 1.6px, #dfd2bc 2.4px
    );
    box-shadow: 2px 0 8px rgba(0,0,0,0.10);
    border-radius: 0 2px 2px 0;
  }

  /* Spine (left side) */
  .book-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; bottom: 0;
    width: 11px;
    background: linear-gradient(to right, #060302 0%, #1a0a04 50%, #060302 100%);
  }

  /* Bookmark */
  .bc-bookmark {
    position: absolute;
    top: 0; right: 64px;
    width: 16px; height: 52px;
    background: linear-gradient(to bottom, #8a2525, #b03030);
    clip-path: polygon(0 0, 100% 0, 100% 80%, 50% 100%, 0 80%);
    box-shadow: -1px 2px 6px rgba(0,0,0,0.40);
    z-index: 2;
  }

  /* Inner frame */
  .bc-frame {
    position: absolute;
    inset: 16px 14px;
    border: 1px solid rgba(195,155,68,0.28);
    pointer-events: none;
    z-index: 1;
  }

  .bc-frame::before {
    content: '';
    position: absolute;
    inset: 5px;
    border: 1px solid rgba(195,155,68,0.12);
  }

  /* Corner ornaments */
  .bc-corner {
    position: absolute;
    width: 16px;
    height: 16px;
    z-index: 2;
    pointer-events: none;
  }

  .bc-corner.tl { top: 22px;    left: 20px;  border-top: 1.5px solid rgba(195,155,68,0.42); border-left: 1.5px solid rgba(195,155,68,0.42); }
  .bc-corner.tr { top: 22px;    right: 20px; border-top: 1.5px solid rgba(195,155,68,0.42); border-right: 1.5px solid rgba(195,155,68,0.42); }
  .bc-corner.bl { bottom: 22px; left: 20px;  border-bottom: 1.5px solid rgba(195,155,68,0.42); border-left: 1.5px solid rgba(195,155,68,0.42); }
  .bc-corner.br { bottom: 22px; right: 20px; border-bottom: 1.5px solid rgba(195,155,68,0.42); border-right: 1.5px solid rgba(195,155,68,0.42); }

  /* Body */
  .bc-body {
    position: relative;
    z-index: 1;
    padding: 46px 40px 68px;
    display: flex;
    flex-direction: column;
  }

  .bc-eyebrow {
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(214,176,96,0.85);
    margin-bottom: 18px;
    font-family: var(--font-sans);
  }

  .bc-hr {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
  }

  .bc-hr-line { flex: 1; height: 1px; background: rgba(195,155,68,0.34); }
  .bc-hr-diamond { font-size: 9px; color: rgba(200,162,72,0.52); }

  .bc-title {
    font-family: var(--font-serif);
    font-size: 68px;
    line-height: 0.92;
    letter-spacing: -0.025em;
    font-weight: 400;
    color: #f5e4c0;
    text-shadow: 0 2px 20px rgba(0,0,0,0.35);
    margin-bottom: 20px;
  }

  .bc-ornament {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .bc-orn-line { width: 30px; height: 1px; background: rgba(195,155,68,0.36); }
  .bc-orn-glyph { font-size: 15px; color: rgba(200,162,72,0.52); font-family: serif; }

  .bc-subtitle {
    font-size: 15px;
    line-height: 1.7;
    color: rgba(214,180,110,0.88);
    margin-bottom: 18px;
    font-family: var(--font-serif);
    font-style: italic;
  }

  .bc-topics {
    font-size: 13px;
    line-height: 1.7;
    color: rgba(214,180,110,0.82);
    font-family: var(--font-sans);
    letter-spacing: 0.02em;
  }

  /* Footer inside card */
  .bc-footer {
    position: absolute;
    bottom: 22px;
    left: 40px; right: 26px;
    border-top: 1px solid rgba(195,155,68,0.18);
    padding-top: 11px;
    display: flex;
    justify-content: space-between;
    z-index: 2;
  }

  .bc-author  { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(214,176,96,0.85); font-family: var(--font-sans); }
  .bc-edition { font-size: 11px; color: rgba(214,176,96,0.75); font-family: var(--font-sans); }

  /* ── Actions below card ── */
  .cover-actions {
    margin-top: 22px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .bc-open {
    display: inline-block;
    padding: 12px 42px;
    border: 1px solid rgba(100,60,20,0.28);
    background: var(--ink);
    color: var(--bg);
    font-size: 15px;
    letter-spacing: 0.04em;
    cursor: pointer;
    font-family: var(--font-serif);
    border-radius: 2px;
    text-decoration: none;
    transition: background 0.18s, transform 0.14s, box-shadow 0.18s;
  }

  .bc-open:hover {
    background: #2e1e0e;
    transform: translateY(-1px);
    box-shadow: 0 4px 18px rgba(0,0,0,0.18);
  }

  /* ── Below the cover: who this is, and what's new ── */
  .home-latest {
    max-width: 1040px;
    margin: 0 auto;
    padding: 56px 32px 96px;
    border-top: 1px solid var(--border);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: 64px;
  }
  .hl-name {
    font-family: var(--font-serif);
    font-size: 30px;
    font-weight: 400;
    line-height: 1.15;
    color: var(--ink);
    margin-bottom: 14px;
  }
  .hl-line {
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-2);
    margin-bottom: 18px;
    max-width: 34ch;
  }
  .hl-title {
    font-family: var(--font-serif);
    font-size: 22px;
    font-weight: 400;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .hl-list ol { list-style: none; margin-bottom: 18px; }
  .hl-list li a {
    display: grid;
    gap: 3px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
  }
  .hl-essay {
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.35;
    color: var(--ink);
    transition: color 0.14s;
  }
  .hl-list li a:hover .hl-essay { color: var(--sienna); }
  .hl-meta { display: flex; gap: 14px; font-size: 13px; color: var(--muted); font-family: var(--font-sans); }
  .hl-more {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--sienna);
    text-decoration: underline;
    text-decoration-color: var(--link-line);
    text-underline-offset: 3px;
  }
  @media (max-width: 760px) {
    .home-latest { grid-template-columns: minmax(0, 1fr); gap: 40px; padding: 40px 24px 72px; }
  }

  @media (max-width: 480px) {
    .book-card { width: 320px; }
    .bc-title { font-size: 52px; }
    .bc-body { padding: 38px 30px 60px; }
    .bc-footer { left: 30px; right: 20px; }
  }
</style>
