---
import BaseLayout from '../layouts/BaseLayout.astro';

const storeUrl = 'https://chromewebstore.google.com/detail/screenguard/dggihakhjjleajeimnfipcgbadkbjdcn';
const title = 'ScreenGuard | Block risky websites before they open';
const description = 'ScreenGuard warns before adult, gambling, phishing, malware and suspicious websites open. It also hides sensitive information while you share your screen.';
const currentPath = '/screenguard';
const faqs = [
  { q: 'What does ScreenGuard block?', a: 'ScreenGuard can warn about or block adult, gambling, phishing, malware and suspicious websites. You can also add sites to your own allow and block lists.' },
  { q: 'Does ScreenGuard send browsing data to a server?', a: 'No. Risk checks use local rules on your device. The extension does not send your browsing history, URLs or page text to a server.' },
  { q: 'How does screen-share protection work?', a: 'Turn on Screen Share Mode before a call. ScreenGuard can hide email addresses, phone numbers, card numbers and API keys, and can block personal-page categories while the mode is active.' }
];
const softwareSchema = {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'ScreenGuard',
  applicationCategory: 'SecurityApplication', operatingSystem: 'Google Chrome', description,
  url: 'https://www.robatdasorvi.com/screenguard', downloadUrl: storeUrl,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'Robat Das Orvi', url: 'https://www.robatdasorvi.com/' }
};
---

<BaseLayout title={title} description={description} currentPath={currentPath} bare={true} faq={faqs} structuredData={softwareSchema} image="/images/screenguard/1-popup.png" imageAlt="ScreenGuard extension popup with protection controls" imageType="image/png" themeColor="#4f46e5">
  <main class="sg-page">
    <nav class="sg-nav" aria-label="ScreenGuard navigation">
      <a class="sg-brand" href="/screenguard" aria-label="ScreenGuard home"><span class="sg-mark" aria-hidden="true">S</span><span>ScreenGuard</span></a>
      <div class="sg-links"><a href="#protection">Protection</a><a href="#privacy">Privacy</a><a class="sg-nav-cta" href={storeUrl} rel="noreferrer">Add to Chrome</a></div>
    </nav>

    <section class="sg-hero">
      <div class="sg-hero-copy">
        <p class="sg-eyebrow"><span aria-hidden="true"></span> Local browser protection</p>
        <h1>Block risky websites <b>before they open.</b></h1>
        <p class="sg-lead">ScreenGuard warns you before adult, gambling, phishing, malware and suspicious websites load. Keep control of the click, wherever it started.</p>
        <div class="sg-actions"><a class="sg-button sg-button-primary" href={storeUrl} rel="noreferrer">Add to Chrome <span aria-hidden="true">→</span></a><a class="sg-button sg-button-quiet" href="#protection">See how it works</a></div>
        <ul class="sg-facts" aria-label="ScreenGuard facts"><li><i class="is-safe" aria-hidden="true"></i>Runs locally</li><li><i class="is-safe" aria-hidden="true"></i>No account</li><li><i class="is-safe" aria-hidden="true"></i>No tracking</li></ul>
      </div>
      <div class="sg-hero-visual">
        <div class="sg-window"><div class="sg-window-bar"><span></span><span></span><span></span><b>ScreenGuard for Chrome</b></div><img src="/images/screenguard/1-popup.png" alt="ScreenGuard browser extension popup" width="1280" height="800" loading="eager" /></div>
        <div class="sg-status-card"><i class="is-safe" aria-hidden="true"></i><div><strong>Protection active</strong><small>Risk checks stay on your device</small></div></div>
      </div>
    </section>

    <section class="sg-signal" aria-label="Risk categories ScreenGuard checks"><span>Adult sites</span><span>Gambling</span><span>Phishing</span><span>Malware</span><span>Suspicious links</span></section>

    <section class="sg-protection" id="protection">
      <div class="sg-section-head"><p class="sg-eyebrow">Protection at the point of action</p><h2>Get the context you need before a page takes over.</h2><p>ScreenGuard stays quiet until it finds a reason to interrupt. When it does, the decision remains yours.</p></div>
      <div class="sg-feature-grid">
        <article class="sg-feature sg-feature-wide"><div class="sg-feature-copy"><span class="sg-number">01</span><h3>Warn before a risky click</h3><p>Hover a link to see a warning. If it is risky, ScreenGuard pauses navigation so you can open it once, allow it, or leave.</p></div><img src="/images/screenguard/2-hover-warning.png" alt="ScreenGuard warning shown beside a risky link" width="1280" height="800" loading="lazy" /></article>
        <article class="sg-feature"><span class="sg-number">02</span><div class="sg-shot sg-shot-blocked"><img src="/images/screenguard/3-blocked.png" alt="ScreenGuard blocked-page warning" width="1280" height="800" loading="lazy" /></div><h3>Cover every route in</h3><p>Typed addresses, bookmarks, redirects and embedded pages get the same check, not only links you click.</p></article>
        <article class="sg-feature"><span class="sg-number">03</span><div class="sg-shot sg-shot-sensitive"><img src="/images/screenguard/4-sensitive-hidden.png" alt="ScreenGuard hiding sensitive information on a page" width="1280" height="800" loading="lazy" /></div><h3>Share without exposing details</h3><p>Screen Share Mode hides email addresses, phone numbers, card numbers and API keys while you present.</p></article>
      </div>
    </section>

    <section class="sg-privacy" id="privacy">
      <div><p class="sg-eyebrow">Private by design</p><h2>Your browsing stays in your browser.</h2></div>
      <div class="sg-privacy-copy"><p>Risk classification uses a local list and rules. Sensitive-content detection reads the page you are viewing, but that text does not leave your browser.</p><ul><li><i class="is-safe" aria-hidden="true"></i>No server or sign-in</li><li><i class="is-safe" aria-hidden="true"></i>No analytics or remote configuration</li><li><i class="is-safe" aria-hidden="true"></i>Settings and protection history stay on this device</li></ul></div>
    </section>

    <section class="sg-faq" id="faq" aria-labelledby="faq-title"><p class="sg-eyebrow">Common questions</p><h2 id="faq-title">What to expect from ScreenGuard.</h2><div class="sg-faq-list">{faqs.map(({ q, a }) => <details><summary>{q}</summary><p>{a}</p></details>)}</div></section>

    <section class="sg-cta"><span class="sg-mark sg-mark-large" aria-hidden="true">S</span><p class="sg-eyebrow">Ready when you are</p><h2>Keep the next click yours.</h2><p>Install ScreenGuard from the Chrome Web Store.</p><a class="sg-button sg-button-primary" href={storeUrl} rel="noreferrer">Add to Chrome <span aria-hidden="true">→</span></a></section>
    <footer class="sg-footer"><a class="sg-brand" href="/screenguard"><span class="sg-mark" aria-hidden="true">S</span><span>ScreenGuard</span></a><span>Made by Robat Das Orvi</span><a href="/store">All projects</a></footer>
  </main>
</BaseLayout>

<style>
  :global(body) { background: #f5f6f9; color: #0f1222; }
  .sg-page { --canvas:#f5f6f9; --surface:#fff; --surface-2:#f7f8fb; --border:#e6e8ef; --text:#0f1222; --text-2:#4b5164; --muted:#5f6675; --primary:#4f46e5; --primary-hover:#4338ca; --primary-soft:#eef0fe; --safe:#07734f; --safe-soft:#e6f5ef; font-family:Inter,ui-sans-serif,system-ui,sans-serif; background:var(--canvas); overflow:hidden; }
  .sg-nav,.sg-hero,.sg-protection,.sg-faq,.sg-footer { width:min(1160px,calc(100% - 48px)); margin:auto; }.sg-nav { height:76px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--border); }.sg-brand { display:flex; align-items:center; gap:9px; color:var(--text); font-size:15px; font-weight:700; letter-spacing:-.025em; text-decoration:none; }.sg-mark { display:grid; width:27px; height:27px; place-items:center; border-radius:8px; background:var(--primary); color:#fff; font-size:15px; font-weight:800; box-shadow:0 5px 12px #4f46e52b; }.sg-links { display:flex; align-items:center; gap:24px; }.sg-links a { color:var(--muted); font-size:13px; font-weight:600; text-decoration:none; }.sg-links a:hover { color:var(--text); }.sg-links .sg-nav-cta { padding:10px 14px; border-radius:8px; background:var(--primary); color:#fff; }.sg-links .sg-nav-cta:hover { background:var(--primary-hover); color:#fff; }.sg-page :focus-visible { outline:3px solid #a9a5ff; outline-offset:4px; }
  .sg-hero { display:grid; grid-template-columns:minmax(0,.92fr) minmax(460px,1.08fr); align-items:center; gap:74px; min-height:635px; padding:58px 0 74px; }.sg-eyebrow { margin:0 0 16px; color:var(--primary); font-size:11px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }.sg-eyebrow span { display:inline-block; width:7px; height:7px; margin-right:8px; border-radius:50%; background:var(--safe); box-shadow:0 0 0 4px var(--safe-soft); }.sg-hero h1,.sg-section-head h2,.sg-privacy h2,.sg-faq h2,.sg-cta h2 { margin:0; color:var(--text); font-size:clamp(43px,5.25vw,70px); font-weight:750; line-height:.99; letter-spacing:-.065em; }.sg-hero h1 b { color:var(--primary); font-weight:inherit; }.sg-lead { max-width:510px; margin:24px 0 0; color:var(--text-2); font-size:17px; line-height:1.58; }.sg-actions { display:flex; gap:12px; margin-top:32px; }.sg-button { display:inline-flex; align-items:center; justify-content:center; gap:12px; padding:13px 17px; border:1px solid transparent; border-radius:9px; font-size:13px; font-weight:750; text-decoration:none; transition:background .18s ease,transform .18s ease; }.sg-button:hover { transform:translateY(-1px); }.sg-button-primary { background:var(--primary); color:#fff; }.sg-button-primary:hover { background:var(--primary-hover); }.sg-button-quiet { border-color:var(--border); background:var(--surface); color:var(--text); }.sg-facts { display:flex; flex-wrap:wrap; gap:17px; padding:0; margin:25px 0 0; color:var(--muted); font-size:12px; list-style:none; }.is-safe { display:inline-block; width:8px; height:8px; margin-right:7px; border-radius:50%; background:var(--safe); box-shadow:0 0 0 3px var(--safe-soft); }.sg-hero-visual { position:relative; }.sg-window { overflow:hidden; border:1px solid #d9dce7; border-radius:14px; background:var(--surface); box-shadow:0 24px 60px #10152d1c; }.sg-window-bar { display:flex; align-items:center; height:35px; gap:5px; padding:0 13px; border-bottom:1px solid var(--border); background:var(--surface-2); }.sg-window-bar span { width:7px; height:7px; border-radius:50%; background:#c4c9d7; }.sg-window-bar b { margin-left:9px; color:#798196; font-size:10px; font-weight:600; }.sg-window img { display:block; width:100%; height:auto; }.sg-status-card { position:absolute; right:-17px; bottom:28px; display:flex; align-items:center; gap:10px; padding:12px 14px; border:1px solid #cbe7da; border-radius:10px; background:#fff; box-shadow:0 13px 30px #10152d18; }.sg-status-card strong,.sg-status-card small { display:block; }.sg-status-card strong { color:var(--text); font-size:12px; }.sg-status-card small { margin-top:3px; color:var(--muted); font-size:10px; }
  .sg-signal { display:flex; justify-content:center; border-top:1px solid var(--border); border-bottom:1px solid var(--border); background:var(--surface); }.sg-signal span { padding:17px clamp(12px,3vw,38px); border-right:1px solid var(--border); color:var(--text-2); font-size:12px; font-weight:650; }.sg-signal span:last-child { border-right:0; }.sg-protection { padding:132px 0; }.sg-section-head { max-width:675px; }.sg-section-head h2,.sg-privacy h2,.sg-faq h2,.sg-cta h2 { font-size:clamp(34px,4.2vw,53px); }.sg-section-head > p:last-child { max-width:535px; margin:22px 0 0; color:var(--text-2); font-size:16px; line-height:1.6; }.sg-feature-grid { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-top:52px; }.sg-feature { overflow:hidden; min-width:0; padding:24px; border:1px solid var(--border); border-radius:16px; background:var(--surface); }.sg-feature-wide { grid-column:span 2; display:grid; grid-template-columns:.76fr 1.24fr; gap:36px; align-items:center; padding-right:0; background:var(--primary-soft); }.sg-number { display:block; margin-bottom:17px; color:var(--primary); font-size:12px; font-weight:800; }.sg-feature h3 { margin:0 0 10px; color:var(--text); font-size:22px; letter-spacing:-.04em; }.sg-feature p { max-width:380px; margin:0; color:var(--text-2); font-size:14px; line-height:1.6; }.sg-feature img { display:block; width:100%; margin:19px 0 22px; border:1px solid #dce0eb; border-radius:9px; box-shadow:0 10px 24px #10152d0d; }.sg-feature-wide img { align-self:end; margin:0 0 -1px; border-radius:10px 0 0 0; }.sg-feature-wide .sg-feature-copy { padding-left:5px; }.sg-shot { height:282px; margin:19px 0 22px; overflow:hidden; border:1px solid #dce0eb; border-radius:10px; background:#f5f6f9; }.sg-shot img { width:100%; height:100%; margin:0; border:0; border-radius:0; box-shadow:none; object-fit:cover; transform-origin:center; }.sg-shot-blocked img { transform:scale(1.62); }.sg-shot-sensitive img { transform:scale(1.42); }
  .sg-privacy { display:grid; grid-template-columns:1fr 1fr; gap:110px; padding:100px max(24px,calc((100% - 1160px)/2)); background:#111325; }.sg-privacy .sg-eyebrow { color:#aab5ff; }.sg-privacy h2 { color:#fff; }.sg-privacy-copy { max-width:490px; padding-top:5px; }.sg-privacy-copy > p { margin:0; color:#c6cad7; font-size:16px; line-height:1.65; }.sg-privacy ul { display:grid; gap:15px; padding:23px 0 0; margin:30px 0 0; border-top:1px solid #2b2f48; color:#eef0f8; font-size:13px; font-weight:600; list-style:none; }.sg-privacy .is-safe { background:#5ee0ae; box-shadow:0 0 0 3px #5ee0ae20; }.sg-faq { padding:125px 0; }.sg-faq-list { margin-top:40px; border-top:1px solid var(--border); }.sg-faq details { border-bottom:1px solid var(--border); }.sg-faq summary { display:flex; justify-content:space-between; padding:21px 0; color:var(--text); cursor:pointer; font-size:16px; font-weight:700; list-style:none; }.sg-faq summary::after { content:'+'; color:var(--primary); font-size:20px; font-weight:400; }.sg-faq details[open] summary::after { content:'−'; }.sg-faq details p { max-width:720px; margin:0 0 21px; color:var(--text-2); font-size:14px; line-height:1.65; }
  .sg-cta { padding:106px 24px; background:var(--primary-soft); text-align:center; }.sg-mark-large { width:39px; height:39px; margin:0 auto 22px; border-radius:11px; font-size:20px; }.sg-cta h2 { max-width:560px; margin:0 auto; }.sg-cta > p:not(.sg-eyebrow) { margin:17px 0 27px; color:var(--text-2); font-size:15px; }.sg-footer { display:flex; align-items:center; justify-content:space-between; min-height:90px; color:var(--muted); font-size:12px; }.sg-footer > a:last-child { color:var(--text-2); font-weight:650; text-decoration:none; }
  @media (max-width:780px) { .sg-nav,.sg-hero,.sg-protection,.sg-faq,.sg-footer { width:calc(100% - 40px); }.sg-links a:not(.sg-nav-cta) { display:none; }.sg-hero { display:block; min-height:auto; padding:70px 0; }.sg-hero-visual { margin-top:53px; }.sg-status-card { right:-5px; bottom:-19px; }.sg-signal { justify-content:flex-start; overflow:auto; }.sg-signal span { white-space:nowrap; }.sg-protection { padding:95px 0; }.sg-feature-grid,.sg-feature-wide { display:block; }.sg-feature { margin-bottom:16px; }.sg-feature-wide { padding-right:24px; }.sg-feature-wide img { margin:27px 0 -25px; border-radius:9px 9px 0 0; }.sg-shot { height:250px; }.sg-privacy { display:block; padding:82px 20px; }.sg-privacy-copy { padding-top:28px; }.sg-faq { padding:90px 0; }.sg-footer { flex-wrap:wrap; gap:17px; padding:25px 0; }.sg-footer span { width:100%; order:3; } }
  @media (prefers-color-scheme:dark) { :global(body) { background:#111325; }.sg-page { --canvas:#111325; --surface:#191c31; --surface-2:#20243d; --border:#303550; --text:#f4f5fa; --text-2:#c1c6d6; --muted:#9ea5ba; --primary-soft:#21254c; }.sg-window,.sg-status-card { background:#191c31; }.sg-window-bar { background:#20243d; }.sg-window-bar b { color:#c1c6d6; }.sg-signal,.sg-feature { background:#191c31; }.sg-feature-wide,.sg-cta { background:#21254c; }.sg-feature img { border-color:#303550; } }
  @keyframes sg-protection-online { from { clip-path:inset(10% 8% 10% 8% round 14px); box-shadow:0 8px 20px #10152d0d; } to { clip-path:inset(0 0 0 0 round 14px); box-shadow:0 24px 60px #10152d1c; } }
  @keyframes sg-status-confirmed { from { opacity:0; transform:translateX(-16px); } to { opacity:1; transform:translateX(0); } }
  @media (prefers-reduced-motion:no-preference) { .sg-window { animation:sg-protection-online 620ms cubic-bezier(.16,1,.3,1) both; }.sg-status-card { animation:sg-status-confirmed 260ms cubic-bezier(.16,1,.3,1) 440ms both; } }
  @media (prefers-reduced-motion:reduce) { .sg-button { transition:none; }.sg-button:hover { transform:none; } }
</style>
