---
import BaseLayout from '../layouts/BaseLayout.astro';
import '@fontsource-variable/ibm-plex-sans/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';

const repo = 'https://github.com/orvi2014/hatswap';
const title = 'hatswap: Run multiple Claude Code accounts at once';
const description = "Open-source CLI that keeps every client's Claude Code account signed in. Pin folders to accounts, switch a live conversation, or hand it to Codex.";
const currentPath = '/hatswap';
const faqs = [
  {
    "q": "Is it allowed to use several Claude Code accounts?",
    "a": "hatswap is for accounts you legitimately hold, such as your own and the seats clients give you. It never switches accounts automatically and does not rotate between accounts when you hit a limit. Creating accounts to get around usage limits, or sharing and reselling them, is against Anthropic's policies."
  },
  {
    "q": "How do I switch Claude Code accounts without logging out?",
    "a": "Add each account once with hatswap add, then run /switch <account> inside Claude Code. The session restarts on the other account and resumes the same conversation; in tmux, iTerm2 and Terminal.app it happens in the same tab."
  },
  {
    "q": "Does hatswap touch my credentials?",
    "a": "No. Sign-in is handled entirely by Claude Code; hatswap only chooses which config folder Claude starts with. Handoff briefs are written through your own Claude login, with common secret formats redacted first."
  },
  {
    "q": "Can one client see another client's conversations?",
    "a": "By default every account shares history, which is what most people want on their own machine. Run hatswap private <account> and that account keeps its conversations and memory to itself."
  },
  {
    "q": "What do I need to run it?",
    "a": "macOS or Linux, Bash 3.2 or later, Python 3 and Claude Code. tmux, iTerm2 or Terminal.app let a switch restart the same tab; the Codex CLI is needed only for Codex handoffs."
  },
  {
    "q": "Is hatswap official?",
    "a": "No. hatswap is an independent, MIT-licensed open-source project. Claude Code's session format is not a public interface, so a Claude Code update can occasionally need hatswap update."
  }
];
const softwareSchema = {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'hatswap',
  applicationCategory: 'DeveloperApplication', operatingSystem: 'macOS, Linux', description,
  softwareVersion: '0.7.0', license: 'https://opensource.org/licenses/MIT',
  url: 'https://www.robatdasorvi.com/hatswap', downloadUrl: repo, codeRepository: repo,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'Robat Das Orvi', url: 'https://www.robatdasorvi.com/' }
};
---

<BaseLayout title={title} description={description} currentPath={currentPath} bare={true} faq={faqs} structuredData={softwareSchema} image="/images/hatswap/social-card.png" imageAlt="hatswap: every client's Claude Code account, signed in at once" imageType="image/png" themeColor="#0F0F0E">
<div class="hs">
<header class="nav">
  <div class="wrap">
    <a class="brand" href="#top" aria-label="hatswap home">
      <svg class="mark swap" viewBox="0 0 256 256" aria-hidden="true"><g class="flip"><g class="h1"><path d="M64 24h72a8 8 0 0 1 8 8v70H56V32a8 8 0 0 1 8-8z"/><rect x="20" y="100" width="160" height="20" rx="10"/></g><g class="h2" transform="rotate(180 128 128)"><path d="M64 24h72a8 8 0 0 1 8 8v70H56V32a8 8 0 0 1 8-8z"/><rect x="20" y="100" width="160" height="20" rx="10"/></g></g></svg>
      hatswap
    </a>
    <nav class="nav-links" aria-label="Main">
      <a class="hide-sm" href="#features">Features</a>
      <a class="hide-sm" href="#how">How it works</a>
      <a class="hide-sm" href="#start">Install</a>
      <a class="hide-sm" href="#compare">Compare</a>
      <a class="hide-sm" href="#faq">FAQ</a>
      <a class="gh" href="https://github.com/orvi2014/hatswap">
        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        Star on GitHub
      </a>
    </nav>
  </div>
</header>

<div id="top">
  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-top">
                <p class="slogan rise d2" aria-hidden="true"><span class="line">Same chat.</span><span class="line accent">Different hat.</span></p>
        <h1 class="what rise d3">An open-source CLI to <b>run multiple Claude Code accounts at once</b>, one per client. Switch a running conversation between them, history intact.</h1>
        <div class="install rise d4">
          <div class="cmd"><span class="p">$</span><code id="ic1">curl -fsSL https://raw.githubusercontent.com/orvi2014/hatswap/main/install.sh | bash</code><button class="copy" type="button" data-copy="ic1">Copy</button></div>
          <a class="btn-ghost" href="https://github.com/orvi2014/hatswap">View on GitHub<span class="stars" data-stars hidden>★ <span data-stars-n></span></span></a>
        </div>
      </div>

      <div class="stage rise d5">
        <div class="term" aria-label="Animated terminal demo of hatswap">
          <div class="term-bar">
            <i></i><i></i><i></i><span class="term-title">~/billing</span>
            <span class="acct" id="acct"><svg viewBox="0 0 256 256" aria-hidden="true"><g fill="#D97757"><path d="M64 24h72a8 8 0 0 1 8 8v70H56V32a8 8 0 0 1 8-8z"/><rect x="20" y="100" width="160" height="20" rx="10"/></g><g fill="#F3F1EC" transform="rotate(180 128 128)"><path d="M64 24h72a8 8 0 0 1 8 8v70H56V32a8 8 0 0 1 8-8z"/><rect x="20" y="100" width="160" height="20" rx="10"/></g></svg><span class="who" id="who">main · personal@example.com</span></span>
          </div>
          <div class="term-body">
            <div class="screen" id="screen"></div>
            <div class="callout" id="callout">Same chat. Different hat.</div>
          </div>
        </div>
        <div class="chips" role="tablist" aria-label="Demo steps" id="chips">
          <button class="chip" type="button" data-step="0"><span class="fill"></span><span><kbd>1</kbd>Pick &amp; pin</span></button>
          <button class="chip" type="button" data-step="1"><span class="fill"></span><span><kbd>2</kbd>Start on the client</span></button>
          <button class="chip" type="button" data-step="2"><span class="fill"></span><span><kbd>3</kbd>Switch mid-chat</span></button>
          <button class="chip" type="button" data-step="3"><span class="fill"></span><span><kbd>4</kbd>Hand off to Codex</span></button>
        </div>
      </div>
    </div>

    <div class="marquee" aria-hidden="true">
      <div class="track">
        <span>Terminal.app</span><span>iTerm2</span><span>tmux</span><span>VS Code</span><span>Cursor</span><span>Claude Desktop</span><span>Codex CLI</span><span>zsh, bash, fish</span><span>status line</span><span>bots via exec</span><span>Claude Code plugin</span>
        <span>Terminal.app</span><span>iTerm2</span><span>tmux</span><span>VS Code</span><span>Cursor</span><span>Claude Desktop</span><span>Codex CLI</span><span>zsh, bash, fish</span><span>status line</span><span>bots via exec</span><span>Claude Code plugin</span>
      </div>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="block" id="problem">
    <div class="wrap">
      <p class="kicker reveal">The problem</p>
      <h2 class="reveal">Changing accounts used to cost you the conversation.</h2>
      <p class="sub reveal">Claude Code holds one login at a time, so switching Claude Code accounts meant logging out, signing in through the browser, and starting again from nothing.</p>
      <div class="vs">
        <div class="card reveal">
          <h3>Without hatswap <span class="tag">context lost</span></h3>
          <p>Every switch is a logout, a browser sign-in and a blank session.</p>
          <div class="mini wipe">
            <span class="r msg"><span class="dim">&gt;</span> Invoice totals are off by a cent</span>
            <span class="r msg"><span class="dot">⏺</span> Found it: tax is rounded before the discount.</span>
            <span class="r msg"><span class="dim">&gt;</span> Fix it and add a test</span>
            <span class="r msg"><span class="dot">⏺</span> Done. 3 files changed, tests pass.</span>
            <span class="lost">the whole conversation, gone</span>
            <div class="cmdline"><span class="t1"><span class="dim">&gt;</span> /logout</span><span class="t2 dim">Opening browser to sign in…</span></div>
          </div>
        </div>
        <div class="card reveal">
          <h3>With hatswap <span class="tag good">same chat</span></h3>
          <p>One command. The tab restarts on the other account and the conversation carries on.</p>
          <div class="mini keep">
            <div class="hdr"><span class="co">✻</span><span class="ticker"><span>main · personal@example.com</span><span>acme · you@acme.example</span><span>main · personal@example.com</span></span></div>
            <span class="r msg"><span class="dim">&gt;</span> Invoice totals are off by a cent</span>
            <span class="r msg"><span class="dot">⏺</span> Found it: tax is rounded before the discount.</span>
            <span class="r msg"><span class="dim">&gt;</span> Fix it and add a test</span>
            <span class="r msg"><span class="dot">⏺</span> Done. 3 files changed, tests pass.</span>
            <div class="sw"><span class="dim">&gt;</span> /switch acme <span class="gr">✓ resumed on you@acme.example</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="block" id="features">
    <div class="wrap">
      <h2 class="reveal">Built for people who bill more than one client.</h2>
      <div class="bento">
        <div class="bx c3 reveal">
          <h3>Multiple accounts, all signed in</h3>
          <p>Each client keeps its own login. Run two of them in two terminals at once. <code class="s">hatswap add acme</code></p>
          <div class="viz vrows">
            <div class="vr"><span class="on"></span><span>main</span><span class="blk">██░░░░░░░░</span><span class="pct">24%</span></div>
            <div class="vr"><span class="on"></span><span>acme</span><span class="blk">██████░░░░</span><span class="pct">64%</span></div>
            <div class="vr"><span class="on"></span><span>work</span><span class="blk">█░░░░░░░░░</span><span class="pct">10%</span></div>
          </div>
        </div>
        <div class="bx c3 tint-coral reveal">
          <h3>Folders that know their client</h3>
          <p>Pin a folder once. Every <code class="s">claude</code> started inside it uses that client's account.</p>
          <div class="viz tree">
            <div class="f">~/clients/</div>
            <div class="f">&nbsp;&nbsp;├─ acme/ <span class="pinchip">acme</span></div>
            <div class="f">&nbsp;&nbsp;├─ globex/ <span class="pinchip w">work</span></div>
            <div class="f">&nbsp;&nbsp;└─ <span class="dim">anywhere else → your default</span></div>
          </div>
        </div>
        <div class="bx c2 reveal">
          <h3>Hand off to Codex</h3>
          <p>Claude writes a brief of the session and repo state; Codex starts from it.</p>
          <div class="viz doc">
            <div class="paper"><b>handoff-brief.md</b><i></i><i></i><i></i><i></i></div>
            <div class="arrow"></div>
            <div class="codex">Codex</div>
          </div>
        </div>
        <div class="bx c2 reveal">
          <h3>Private history per client</h3>
          <p>History is shared by default. Mark a client private and its chats stay with it.</p>
          <div class="viz lockviz">
            <div class="folder"><b>acme</b>private history</div>
            <span class="sep">not shared</span>
            <div class="folder"><b>work</b>shared history</div>
          </div>
        </div>
        <div class="bx c2 tint-ink reveal">
          <h3>Always know where you are</h3>
          <p>The account sits in Claude Code's status line. <code class="s">statusline --install</code></p>
          <div class="viz status">
            <div class="body">&gt; review the migration</div>
            <div class="bar"><span class="acc">◆</span><span class="typing">acme · you@acme.example</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW -->
  <section class="block" id="how">
    <div class="wrap">
      <p class="kicker reveal">How it works</p>
      <h2 class="reveal">One folder per login. Everything else is shared.</h2>
      <div class="how">
        <div class="diagram reveal">
          <svg viewBox="0 0 560 330" role="img" aria-label="~/.claude is linked into three account folders, each with its own login">
            <rect class="node shared" x="120" y="18" width="320" height="96" rx="12"/>
            <text class="ts" x="140" y="48">~/.claude</text>
            <text x="140" y="72">settings, skills, plugins, hooks</text>
            <text x="140" y="94">CLAUDE.md, agents, history</text>
            <path class="wire" d="M240 114 C 240 170, 100 160, 100 210"/>
            <path class="wire" d="M280 114 L 280 210" style="animation-delay:-.4s"/>
            <path class="wire" d="M320 114 C 320 170, 460 160, 460 210" style="animation-delay:-.8s"/>
            <text x="292" y="168">symlinks</text>
            <g>
              <rect class="node" x="22" y="210" width="156" height="96" rx="12"/>
              <text class="t" x="40" y="242">main</text>
              <circle class="key" cx="46" cy="276" r="5"/><text x="58" y="280">personal login</text>
            </g>
            <g>
              <rect class="node" x="202" y="210" width="156" height="96" rx="12"/>
              <text class="t" x="220" y="242">acme</text>
              <circle class="key" cx="226" cy="276" r="5"/><text x="238" y="280">acme login</text>
            </g>
            <g>
              <rect class="node" x="382" y="210" width="156" height="96" rx="12"/>
              <text class="t" x="400" y="242">work</text>
              <circle class="key" cx="406" cy="276" r="5"/><text x="418" y="280">work login</text>
            </g>
          </svg>
        </div>
        <ul class="points">
          <li class="reveal"><div><strong>Logins stay separate</strong>Each account is its own <code>CLAUDE_CONFIG_DIR</code>, so Claude Code keeps a separate sign-in for it (its own Keychain item on macOS). hatswap never reads or copies credentials.</div></li>
          <li class="reveal"><div><strong>Your setup is written once</strong>Settings, skills, plugins, hooks and history are linked from <code>~/.claude</code>. Nothing to keep in sync.</div></li>
          <li class="reveal"><div><strong>Plain <code>claude</code> picks the account</strong>A one-line shell hook finds the nearest pinned folder, falls back to your default, and starts Claude there.</div></li>
          <li class="reveal"><div><strong>It never switches on its own</strong>Accounts change only when you ask. <code>hatswap usage</code> reports limits and does nothing else.</div></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- QUICKSTART -->
  <section class="block" id="start">
    <div class="wrap">
      <h2 class="reveal">Running in two minutes.</h2>
      <div class="qs">
        <div class="steps" role="tablist" aria-label="Setup steps" id="qs-steps">
          <button type="button" role="tab" aria-selected="true" data-i="0"><span class="n">1</span><span><b>Install</b><small>PATH, shell hook and slash commands</small></span></button>
          <button type="button" role="tab" aria-selected="false" data-i="1"><span class="n">2</span><span><b>Add a client's account</b><small>A browser window opens to sign in</small></span></button>
          <button type="button" role="tab" aria-selected="false" data-i="2"><span class="n">3</span><span><b>Pin folders, pick a default</b><small>So plain claude chooses for you</small></span></button>
          <button type="button" role="tab" aria-selected="false" data-i="3"><span class="n">4</span><span><b>Work as usual</b><small>Switch whenever you need to</small></span></button>
        </div>
        <div class="qs-term reveal">
          <div class="term-bar"><i></i><i></i><i></i><span class="term-title">zsh</span></div>
          <pre id="qs-pre"></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="block" id="compare">
    <div class="wrap">
      <h2 class="reveal">More than a CLAUDE_CONFIG_DIR alias</h2>
      <p class="sub reveal">An alias per account gets you a second login. hatswap adds what client work needs on top. See <a href="https://github.com/orvi2014/hatswap#how-this-differs-from-other-account-switchers">how it differs from other account switchers</a>.</p>
      <div class="compare reveal">
        <table>
          <thead><tr><th scope="col"></th><th scope="col">alias claude-acme='CLAUDE_CONFIG_DIR=… claude'</th><th scope="col">hatswap</th></tr></thead>
          <tbody>
            <tr><td>A separate login per account</td><td class="y">Yes</td><td class="y">Yes</td></tr>
            <tr><td>Settings, skills, plugins and history shared</td><td class="n">No, each folder starts empty</td><td class="y">Yes, linked from ~/.claude</td></tr>
            <tr><td>Plain <code>claude</code> picks the account per folder</td><td class="n">No</td><td class="y">Yes, with <code>pin</code></td></tr>
            <tr><td>Move a live conversation to another account</td><td class="n">No</td><td class="y">Yes, <code>/switch</code></td></tr>
            <tr><td>Hand a session to Codex with a brief</td><td class="n">No</td><td class="y">Yes, <code>/handoff codex</code></td></tr>
            <tr><td>Every account's usage in one table</td><td class="n">No</td><td class="y">Yes, <code>usage</code></td></tr>
            <tr><td>Switches accounts automatically at a limit</td><td class="n">No</td><td class="n">No, by design</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="block" id="faq">
    <div class="wrap">
      <h2 class="reveal">Before you install</h2>
      <div class="faq">
        {faqs.map(({ q, a }, i) => <details open={i === 0}><summary>{q}</summary><p>{a}</p></details>)}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="block cta">
    <div class="wrap">
      <svg class="mark swap big reveal" viewBox="0 0 256 256" aria-hidden="true"><g class="flip"><g class="h1"><path d="M64 24h72a8 8 0 0 1 8 8v70H56V32a8 8 0 0 1 8-8z"/><rect x="20" y="100" width="160" height="20" rx="10"/></g><g class="h2" transform="rotate(180 128 128)"><path d="M64 24h72a8 8 0 0 1 8 8v70H56V32a8 8 0 0 1 8-8z"/><rect x="20" y="100" width="160" height="20" rx="10"/></g></g></svg>
      <h2 class="reveal">The right hat for every client.</h2>
      <p class="sub reveal">Free and open source. One line to install.</p>
      <div class="install reveal">
        <div class="cmd"><span class="p">$</span><code id="ic2">curl -fsSL https://raw.githubusercontent.com/orvi2014/hatswap/main/install.sh | bash</code><button class="copy" type="button" data-copy="ic2">Copy</button></div>
        <a class="btn-ghost" href="https://github.com/orvi2014/hatswap">Star on GitHub</a>
      </div>
    </div>
  </section>
</div>

<footer>
  <div class="wrap">
    <span class="maker">Made by <a href="/">Robat Das Orvi</a></span>
    <a href="/store">All projects</a>
    <a href="https://github.com/orvi2014/hatswap#readme">Docs</a>
    <a href="https://github.com/orvi2014/hatswap/blob/main/LICENSE">MIT license</a>
    <a href="https://github.com/orvi2014/hatswap/blob/main/CHANGELOG.md">Changelog</a>
    <a href="https://github.com/orvi2014/hatswap/issues">Issues</a>
    <span class="sp">Independent project. Not affiliated with Anthropic or OpenAI.</span>
