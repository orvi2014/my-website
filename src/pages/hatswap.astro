  color: var(--faint); font-size: 12.5px;
}
.term-bar i { width: 11px; height: 11px; border-radius: 50%; background: #2C2A27; display: block; }
.term-title { margin-left: 14px; }
.acct {
  margin-left: auto; display: inline-flex; align-items: center; gap: 8px; padding: 3px 10px 3px 6px;
  border: 1px solid var(--line-2); border-radius: 999px; color: var(--ink); background: var(--panel);
  perspective: 400px;
}
.acct svg { width: 18px; height: 18px; transition: transform .7s var(--ease); }
.acct.flip svg { transform: rotate(180deg); }
.acct .who { display: inline-block; transition: opacity .25s, transform .35s var(--ease); }
.acct.out .who { opacity: 0; transform: translateY(-6px); }
.term-body { height: 430px; overflow-x: auto; scrollbar-width: none; padding: 18px 22px; overflow: hidden; position: relative; }
.screen { white-space: pre-wrap; word-break: break-word; }
.screen .ln { min-height: 1.72em; }
.dim { color: var(--faint); }
.mut { color: var(--muted); }
.co { color: var(--coral); }
.gr { color: var(--green); }
.bl { color: var(--blue); }
.b { font-weight: 700; }
.caret { display: inline-block; width: .6em; height: 1.15em; background: var(--ink); vertical-align: -.2em; margin-left: 1px; animation: blink 1s steps(1) infinite; }
@keyframes blink { 50% { opacity: 0; } }
.fadein { animation: fadein .35s ease both; }
@keyframes fadein { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
.pk-row { display: block; border-radius: 5px; padding: 0 6px; margin: 0 -6px; transition: background .25s; white-space: pre; }
.pk-row.sel { background: #24211F; }
.pk-row.sel .nm { color: var(--coral); font-weight: 700; }
.keyflash { display: inline-block; padding: 0 6px; border-radius: 4px; background: var(--coral); color: #1A0F0B; font-weight: 700; animation: kf .6s ease both; }
@keyframes kf { from { transform: scale(1.4); } to { transform: none; } }
.user { color: var(--ink); }
