    });
  }
  qsb.forEach(function (b, i) { b.addEventListener("click", function () { clearInterval(qsTimer); showQs(i); }); });
  showQs(0);

})();
</script>
</BaseLayout>

<style is:global>
/* Layout: dark terminal world (single committed theme). A live, self-playing terminal is the hero; every section below proves one claim with its own small loop. */
.hs {
  color-scheme: dark;
  --bg: #0F0F0E;
  --bg-2: #151513;
  --panel: #1A1917;
  --panel-2: #211F1D;
  --line: #2A2825;
  --line-2: #3A3733;
  --ink: #F3F1EC;
  --muted: #A7A49D;
  --faint: #6F6C66;
  --coral: #E5876A;
  --coral-deep: #D97757;
  --coral-wash: rgba(217, 119, 87, .14);
  --green: #A6D28F;
  --green-wash: rgba(166, 210, 143, .12);
  --blue: #8FB7E8;
  --font-sans: "IBM Plex Sans Variable", ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  --font-mono: "JetBrains Mono Variable", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  --col: 1160px;
  --ease: cubic-bezier(.22, .9, .25, 1);
}
* { box-sizing: border-box; }
body { background: #0F0F0E; }
.hs {
  background: var(--bg); color: var(--ink);
  font-family: var(--font-sans); font-size: 16px; line-height: 1.55;
  -webkit-font-smoothing: antialiased; overflow-x: hidden;
}
a { color: inherit; }
code, pre, kbd { font-family: var(--font-mono); }
:focus-visible { outline: 2px solid var(--coral); outline-offset: 3px; border-radius: 6px; }
.wrap {
  max-width: var(--col); margin: 0 auto;
  padding-left: max(20px, env(safe-area-inset-left, 0px));
  padding-right: max(20px, env(safe-area-inset-right, 0px));
}

/* ---------- nav ---------- */
.nav {
  position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20;
  background: rgba(15, 15, 14, .78); border-bottom: 1px solid var(--line);
  backdrop-filter: saturate(1.3) blur(12px); -webkit-backdrop-filter: saturate(1.3) blur(12px);
}
.nav .wrap { display: flex; align-items: center; gap: 28px; height: 62px; }
.brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 600; font-size: 18px; letter-spacing: -.01em; }
.brand .mark { width: 26px; height: 26px; }
.nav-links { margin-left: auto; display: flex; align-items: center; gap: 26px; font-size: 14.5px; color: var(--muted); }
.nav-links a { text-decoration: none; transition: color .2s; }
.nav-links a:hover { color: var(--ink); }
.gh {
  display: inline-flex; align-items: center; gap: 8px; padding: 7px 13px; border-radius: 8px;
  border: 1px solid var(--line-2); background: var(--panel); color: var(--ink) !important; font-weight: 500;
}
.gh svg { width: 16px; height: 16px; }
@media (max-width: 760px) { .nav-links .hide-sm { display: none; } }

/* ---------- hat mark (animated swap) ---------- */
.mark .h1 { fill: var(--coral-deep); }
.mark .h2 { fill: var(--ink); }
.mark .flip { transform-origin: 128px 128px; transform-box: view-box; }
.mark.swap .flip { animation: hatswap 6s var(--ease) infinite; }
@keyframes hatswap {
  0%, 38% { transform: rotate(0deg); }
  50%, 88% { transform: rotate(180deg); }
  100% { transform: rotate(360deg); }
}

/* ---------- hero ---------- */
.hero { position: relative; padding-block: 76px 40px; isolation: isolate; }
.hero-top { display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; text-align: center; }
.hero-top > * { max-width: 100%; }
.pill {
  display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 12.5px;
  color: var(--muted); border: 1px solid var(--line-2); background: var(--panel);
  padding: 5px 13px 5px 6px; border-radius: 999px; text-decoration: none; transition: border-color .2s;
  max-width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.pill:hover { border-color: var(--faint); }
.pill b { background: var(--coral-wash); color: var(--coral); padding: 2px 8px; border-radius: 999px; }
h1 {
  margin: 0; font-weight: 600; letter-spacing: -.045em; line-height: .98;
  font-size: clamp(46px, 8.6vw, 104px); text-wrap: balance;
}
h1 .line { display: block; }
h1 .accent { color: var(--coral); }
.hero .lede { margin: 26px auto 0; max-width: 60ch; color: var(--muted); font-size: clamp(17px, 2vw, 20px); text-wrap: pretty; }
.hero .lede b { color: var(--ink); font-weight: 500; }
.install { margin-top: 34px; display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; width: 100%; }
.cmd {
  display: flex; align-items: center; gap: 12px; min-width: 0; flex: 0 1 640px;
  background: var(--panel); border: 1px solid var(--line-2); border-radius: 14px; padding: 6px 6px 6px 16px;
  font-family: var(--font-mono); font-size: 14px; text-align: left;
}
.cmd .p { color: var(--coral); user-select: none; }
.cmd code { flex: 1; min-width: 0; overflow-x: auto; white-space: nowrap; padding-block: 9px; scrollbar-width: none; }
.cmd code::-webkit-scrollbar { display: none; }
.copy {
  flex: none; font: 600 13px var(--font-sans); color: #1A0F0B; background: var(--coral);
  border: 0; border-radius: 8px; padding: 9px 14px; cursor: pointer; transition: transform .15s, background .2s;
}
.copy:hover { background: #EE9A7F; }
.copy:active { transform: scale(.97); }
.btn-ghost {
  display: inline-flex; align-items: center; gap: 8px; min-height: 50px; padding: 0 18px; border-radius: 14px;
  border: 1px solid var(--line-2); text-decoration: none; font-weight: 500; transition: border-color .2s, background .2s;
}
.btn-ghost:hover { border-color: var(--faint); background: var(--panel); }
.meta { margin-top: 18px; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 22px; font: 13px var(--font-mono); color: var(--faint); }
.meta span::before { content: "·"; margin-right: 22px; color: var(--line-2); }
.meta span:first-child::before { content: none; }

/* entrance */
@media (prefers-reduced-motion: no-preference) {
  .rise { animation: rise .9s var(--ease) both; }
  .d1 { animation-delay: .06s; } .d2 { animation-delay: .16s; } .d3 { animation-delay: .26s; } .d4 { animation-delay: .36s; } .d5 { animation-delay: .5s; }
  @keyframes rise { from { transform: translateY(18px); opacity: .001; } to { transform: none; opacity: 1; } }
}

/* ---------- live terminal ---------- */
.stage { margin-top: 56px; position: relative; }
