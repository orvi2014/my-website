</footer>

</div>

<script is:inline>
(function () {
  var reduce = false;
  try { reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches; } catch (e) {}

  /* ---------- GitHub stars (shown once there are enough to mean something) ---------- */
  try {
    fetch("https://api.github.com/repos/orvi2014/hatswap").then(function (r) { return r.ok ? r.json() : null; }).then(function (d) {
      if (!d || typeof d.stargazers_count !== "number" || d.stargazers_count < 10) return;
      document.querySelectorAll("[data-stars]").forEach(function (el) {
        el.querySelector("[data-stars-n]").textContent = d.stargazers_count.toLocaleString("en-US");
        el.hidden = false;
      });
    }).catch(function () {});
  } catch (e) {}

  /* ---------- copy buttons ---------- */
  document.querySelectorAll(".copy").forEach(function (b) {
    b.addEventListener("click", function () {
      var el = document.getElementById(b.dataset.copy);
      var reset = function (t) { b.textContent = t; setTimeout(function () { b.textContent = "Copy"; }, 1700); };
      var fallback = function () {
        var r = document.createRange(); r.selectNodeContents(el);
        var s = window.getSelection(); s.removeAllRanges(); s.addRange(r); reset("⌘C to copy");
      };
      try { navigator.clipboard.writeText(el.textContent).then(function () { reset("Copied"); }, fallback); } catch (e) { fallback(); }
    });
  });

  /* ---------- live terminal ---------- */
  var screen = document.getElementById("screen");
  var acct = document.getElementById("acct");
  var who = document.getElementById("who");
  var callout = document.getElementById("callout");
  var chips = Array.prototype.slice.call(document.querySelectorAll("#chips .chip"));
  var run = 0;
  var MAXLINES = 15;

  function esc(s) { return s.replace(/&/g, "&amp;").replace(/</g, "&lt;"); }
  function sleep(ms, id) {
    return new Promise(function (res, rej) { setTimeout(function () { id === run ? res() : rej("x"); }, reduce ? Math.min(ms, 900) : ms); });
  }
  function trim() { while (screen.children.length > MAXLINES) screen.removeChild(screen.firstChild); }
  function line(html, cls) {
    var d = document.createElement("div"); d.className = "ln fadein" + (cls ? " " + cls : ""); d.innerHTML = html || "";
    screen.appendChild(d); trim(); return d;
  }
  async function type(prefix, text, id, speed) {
    var d = line(prefix + '<span class="tx"></span><span class="caret"></span>');
    var tx = d.querySelector(".tx");
    if (reduce) { tx.textContent = text; }
    else for (var i = 1; i <= text.length; i++) { tx.textContent = text.slice(0, i); await sleep(speed || 42, id); }
    await sleep(260, id);
    var c = d.querySelector(".caret"); if (c) c.remove();
    return d;
  }
  function setAcct(text, flip) {
    acct.classList.add("out");
    setTimeout(function () { who.textContent = text; acct.classList.remove("out"); }, 260);
    if (flip) acct.classList.toggle("flip");
  }
  function bar(p) { var n = Math.round(p / 100 * 6); return "█".repeat(n) + "░".repeat(6 - n); }
  function lp(s, n) { s = String(s); return " ".repeat(Math.max(0, n - s.length)) + s; }
  var accts = [["main", "personal@example.com", 12, 34], ["acme", "you@acme.example    ", 64, 41], ["work", "work@example.com    ", 10, 27]];
  function pickRow(a, sel, tag) {
    return '<span class="pk-row' + (sel ? " sel" : "") + '">' + (sel ? '<span class="co">▸</span>' : " ") + ' <span class="nm">' + a[0] + '</span>  <span class="dim">' + a[1] + '</span>  <span class="dim">5h</span>' +
      lp(a[2] + "%", 4) + " " + bar(a[2]) + '  <span class="dim">week</span>' + lp(a[3] + "%", 4) + " " + bar(a[3]) + "  " + (tag || "") + "</span>";
  }
  var prompt = '<span class="gr">~/billing</span> <span class="dim">$</span> ';
  var conv = [
    ['<span class="user">Invoice totals are off by a cent when a discount applies</span>'],
    ['<span class="dot">⏺</span> Found it: tax is rounded before the discount is applied.'],
    ['<span class="dot">⏺</span> Fixed <span class="bl">src/invoice.ts</span> and added a test. <span class="gr">3 files changed, tests pass.</span>']
  ];

  var steps = [
    async function (id) { // pick & pin
      screen.innerHTML = ""; callout.classList.remove("on");
      setAcct("main · personal@example.com", false); acct.classList.remove("flip");
      await type(prompt, "hatswap", id);
      var head = line('<span class="co b">hatswap</span> <span class="dim">─ new sessions in ~/billing start on</span> main');
      line("");
      var rows = accts.map(function (a, i) { return line(pickRow(a, i === 0, i === 0 ? '<span class="co">★ default</span>' : "")); });
      line("");
      var help = line('<span class="dim">↑↓ choose  ⏎ start claude  d default  p pin folder  q quit</span>');
      await sleep(1100, id);
      rows[0].innerHTML = pickRow(accts[0], false, '<span class="co">★ default</span>');
      rows[1].innerHTML = pickRow(accts[1], true, "");
      await sleep(900, id);
      help.innerHTML = '<span class="keyflash">p</span> <span class="dim">pin this folder</span>';
      await sleep(500, id);
      rows[1].innerHTML = pickRow(accts[1], true, '<span class="gr">● pinned here</span>');
      head.innerHTML = '<span class="co b">hatswap</span> <span class="dim">─ new sessions in ~/billing start on</span> <span class="co">acme</span>';
      line('<span class="gr">✓</span> Pinned ~/billing to acme.');
      await sleep(2000, id);
    },
    async function (id) { // start on the client
      screen.innerHTML = "";
      await type(prompt, "claude", id);
      setAcct("acme · you@acme.example", true);
      line('<span class="banner"><span class="co">✻</span> Claude Code  <span class="dim">you@acme.example · ~/billing</span></span>');
      await sleep(600, id);
      await type('<span class="dim">&gt; </span>', "Invoice totals are off by a cent when a discount applies", id, 26);
      await sleep(500, id);
      line(conv[1][0]); await sleep(900, id);
      line(conv[2][0]); await sleep(2000, id);
    },
    async function (id) { // switch mid-chat
      if (!screen.textContent.includes("Claude Code")) {
        screen.innerHTML = ""; acct.classList.add("flip"); who.textContent = "acme · you@acme.example";
        line('<span class="banner"><span class="co">✻</span> Claude Code  <span class="dim">you@acme.example · ~/billing</span></span>');
        conv.forEach(function (c) { line(c[0]); });
      }
      await sleep(400, id);
      await type('<span class="dim">&gt; </span>', "/switch work", id, 60);
      line('<span class="co">Switching to \'work\':</span> Invoice totals are off by a cent when a discount applies');
      line('<span class="dim">This tab restarts on work@example.com, same conversation.</span>');
      await sleep(1200, id);
      screen.classList.remove("restart"); void screen.offsetWidth; screen.classList.add("restart");
      await sleep(250, id);
      screen.innerHTML = "";
      setAcct("work · work@example.com", true);
      line('<span class="banner"><span class="co">✻</span> Claude Code  <span class="dim">work@example.com · ~/billing · resumed</span></span>');
      conv.forEach(function (c) { line(c[0]); });
      await sleep(500, id);
      callout.classList.add("on");
      await sleep(2600, id);
      callout.classList.remove("on");
      await sleep(300, id);
    },
    async function (id) { // hand off
      if (!screen.textContent.includes("resumed")) {
        screen.innerHTML = ""; acct.classList.remove("flip"); who.textContent = "work · work@example.com";
        line('<span class="banner"><span class="co">✻</span> Claude Code  <span class="dim">work@example.com · ~/billing · resumed</span></span>');
        conv.forEach(function (c) { line(c[0]); });
      }
      callout.classList.remove("on");
      await type('<span class="dim">&gt; </span>', "/handoff codex", id, 60);
      var w = line('<span class="dot">⏺</span> Writing handoff brief');
      for (var k = 0; k < 3; k++) { await sleep(380, id); w.innerHTML += "."; }
      ["## Goal", "## Done (verified)", "## In flight", "## Next step"].forEach(function (h) { line('<span class="dim">  ' + h + "</span>"); });
      await sleep(500, id);
      line('<span class="gr">✓</span> Brief saved <span class="dim">~/.claude-accounts/briefs/invoice-rounding.md (~7 KB)</span>');
      await sleep(900, id);
      await type(prompt, "hatswap handoff codex --from invoice-rounding.md", id, 30);
      line('<span class="bl">◆</span> Codex  <span class="dim">work@example.com · started from the handoff brief</span>');
      await sleep(2600, id);
    }
  ];

  var fills = chips.map(function (c) { return c.querySelector(".fill"); });
  var anim = null;
  function markChip(i) {
    chips.forEach(function (c, j) { c.classList.toggle("on", j === i); c.setAttribute("aria-selected", j === i ? "true" : "false"); fills[j].style.width = j < i ? "100%" : "0"; });
    if (anim) anim.cancel();
    if (!reduce && fills[i].animate) anim = fills[i].animate([{ width: "0%" }, { width: "100%" }], { duration: [7000, 6500, 7500, 8000][i], easing: "linear", fill: "forwards" });
  }
  async function play(from) {
    var id = ++run, i = from;
    try {
      while (true) {
        markChip(i);
        await steps[i](id);
        i = (i + 1) % steps.length;
      }
    } catch (e) { /* superseded by a newer run */ }
  }
  chips.forEach(function (c) { c.addEventListener("click", function () { play(+c.dataset.step); }); });

  // pause the demo while it's off screen, resume where it was
  var current = 0, visible = true;
  var origMark = markChip;
  markChip = function (i) { current = i; origMark(i); };
  if ("IntersectionObserver" in window) {
    new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (e.isIntersecting && !visible) { visible = true; play(current); }
        else if (!e.isIntersecting && visible) { visible = false; run++; if (anim) anim.pause(); }
      });
    }, { threshold: .15 }).observe(document.querySelector(".term"));
  }
  play(0);

  /* bento: run each card's little animation once, when it scrolls into view */
  var bxs = document.querySelectorAll(".bx");
  if ("IntersectionObserver" in window) {
    var bo = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add("seen"); bo.unobserve(e.target); } }); }, { threshold: .4 });
    bxs.forEach(function (b) { bo.observe(b); });
  } else bxs.forEach(function (b) { b.classList.add("seen"); });

  /* ---------- quickstart tabs ---------- */
  var qs = [
    '<span class="dim">$</span> curl -fsSL https://raw.githubusercontent.com/orvi2014/hatswap/main/install.sh | bash\n<span class="gr">✓</span> Installed hatswap 0.7.0 to ~/.local/bin\n<span class="gr">✓</span> Added the shell hook to ~/.zshenv\n<span class="gr">✓</span> Installed /switch and /handoff\n\n<span class="dim">Open a new terminal, then:</span> hatswap add &lt;name&gt;',
    '<span class="dim">$</span> hatswap add acme --email you@acme.example\n<span class="dim">Opening your browser to sign in…</span>\n<span class="gr">✓</span> acme signed in as you@acme.example\n\n<span class="dim">$</span> hatswap list\n  main   personal@example.com   <span class="dim">(~/.claude)</span>\n  acme   you@acme.example',
    '<span class="dim">$</span> cd ~/clients/acme &amp;&amp; hatswap pin acme\n<span class="gr">✓</span> Pinned ~/clients/acme to acme\n\n<span class="dim">$</span> hatswap default main\n<span class="gr">✓</span> Plain claude now starts on main\n  <span class="dim">(pinned folders still use their own account)</span>',
    '<span class="dim">$</span> claude\n<span class="co">✻</span> Claude Code  <span class="dim">you@acme.example · ~/clients/acme</span>\n\n<span class="dim">&gt;</span> /switch main      <span class="dim"># same chat, other account</span>\n<span class="dim">&gt;</span> /handoff codex    <span class="dim"># brief → fresh Codex session</span>\n\n<span class="dim">$</span> hatswap usage     <span class="dim"># every account\'s 5h and weekly use</span>'
  ];
  var pre = document.getElementById("qs-pre");
  var qsb = Array.prototype.slice.call(document.querySelectorAll("#qs-steps button"));
  var qsTimer = null, qsRun = 0;
  function showQs(i) {
    qsb.forEach(function (b, j) { b.setAttribute("aria-selected", j === i ? "true" : "false"); });
