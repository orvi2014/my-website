.dot { color: var(--coral); }
.banner { display: inline-block; border: 1px solid #3A2A24; border-radius: 8px; padding: 6px 14px; margin: 2px 0 6px; }
.restart { animation: restart .7s ease both; }
@keyframes restart { 0% { opacity: 1; } 35% { opacity: .05; filter: blur(1px); } 100% { opacity: 1; } }

.callout {
  position: absolute; right: 22px; bottom: 22px; padding: 12px 18px; border-radius: 14px;
  background: var(--coral); color: #1A0F0B; font: 600 20px/1.2 var(--font-sans); letter-spacing: -.02em;
  box-shadow: 0 18px 40px -16px rgba(0, 0, 0, .7);
