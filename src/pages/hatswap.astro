@keyframes marq { to { transform: translateX(-50%); } }

/* before / after */
.vs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 56px; }
.card { background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 26px; min-width: 0; }
